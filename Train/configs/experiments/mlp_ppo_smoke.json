{
  "schema_version": 2,
  "experiment": {
    "name": "attitude_mlp_ppo_smoke",
    "entrypoint": {"type": "flight_train.runner:run_experiment", "version": "train-framework-v1"}
  },
  "seed": {"base": 20260722, "deterministic_algorithms": true, "cudnn_benchmark": false},
  "run": {
    "device": "cpu", "dtype": "float32", "parallel_count": 8,
    "total_control_steps": 128, "output_root": "../../runs", "allow_unimplemented_simulator": false
  },
  "environment": {
    "factory": "simenv:SimulationEnvironment",
    "config_path": "../environment/sim_smoke.json",
    "observation_source": "truth"
  },
  "command_source": {
    "type": "flight_train.commands:VirtualPilotCommandSource", "version": "2", "seed": 51002,
    "params": {
      "throttle": {
        "minimum": 0.2, "maximum": 0.85,
        "spool": {"duration_s": 1.0, "target_range": [0.3, 0.4]},
        "height_controller": {
          "observation_source": "truth", "target_m": 0.0,
          "initial_throttle_range": [0.48, 0.60],
          "proportional_gain": 0.08, "integral_gain": 0.04, "error_limit_m": 5.0
        },
        "slew_rate": {"rise_per_s": 0.5, "fall_per_s": 0.35}
      },
      "sticks": {
        "roll": {"mode": "angle", "limit_rad": 0.35, "time_constant_s": 0.2},
        "pitch": {"mode": "angle", "limit_rad": 0.35, "time_constant_s": 0.2},
        "yaw": {"mode": "rate", "limit_rad_s": 1.5, "time_constant_s": 0.3},
        "target_sampling": {"distribution": "centered", "center_exponent": 2.0, "hold_duration_s": {"range": [1.0, 4.0]}},
        "reset": {"filtered_stick": "zero", "initial_target_scale": 0.25}
      }
    }
  },
  "control_contract": {
    "version": "self_stabilize_v1", "observation_profile": "attitude_self_stabilize_21d_v3",
    "action_transform": {"type": "residual_around_trim", "trim_command": [0.5, 0.0, 0.0, 0.0], "residual_scale": [0.5, 1.0, 1.0, 1.0]},
    "policy_action": {"fields": ["lower_motor", "servo_1", "servo_2", "servo_3"]},
    "external_action": {"fields": ["upper_motor"]},
    "simulator_command": {"fields": ["upper_motor", "lower_motor", "servo_1", "servo_2", "servo_3"]}
  },
  "randomization": {
    "static": {
      "seed": 31002, "scope": "episode", "parameters": {
        "body.mass": {"range": [-0.1, 0.1], "distribution": "uniform", "mode": "relative", "unit": "ratio", "seed_stream": "static.body.mass"}
      }
    },
    "dynamic": {
      "seed": 41002, "scope": "simulator", "parameters": {
        "sensors.gyro.noise.stddev": {"stddev": [0.0002, 0.0002, 0.0002], "distribution": "normal", "valid_range": [0.0, 0.01], "on_out_of_range": "clamp", "seed_stream": "dynamic.sensor.gyro.noise"}
      }
    }
  },
  "task": {
    "episode_duration_s": 0.032,
    "episode_curriculum": {
      "durations_s": [0.008, 0.016, 0.032],
      "target_scales": [0.0, 0.5, 1.0],
      "success_fraction": 0.5,
      "evaluation_episodes_per_env": 0.5,
      "consecutive_passes": 1
    },
    "termination": {"max_tilt_rad": 1.3, "max_angular_rate_rad_s": 20.0}
  },
  "reward": {
    "calculator": {"type": "flight_train.rewards.attitude:AttitudeRewardCalculator", "version": "3", "params": {"roll_pitch_weight": 2.0, "tilt_weight": 2.0, "yaw_rate_weight": 0.05, "angular_rate_weight": 0.05, "action_rate_weight": 0.01, "saturation_weight": 0.02, "alive_bonus": 0.1}},
    "context": {"fields": [
      {"name": "attitude_geodesic_rad", "source": "task"},
      {"name": "angular_velocity_b", "source": "sensor"},
      {"name": "static_domain", "source": "train_randomizer"}
    ]}
  },
  "model": {
    "type": "mlp_actor_critic",
    "hidden_sizes": [256, 256, 128],
    "exploration": {"initial_action_std": [0.12, 0.25, 0.25, 0.25], "final_action_std": [0.03, 0.05, 0.05, 0.05], "decay_control_steps": 96}
  },
  "algorithm": {
    "name": "ppo", "gamma": 0.995, "gae_lambda": 0.95, "clip_epsilon": 0.2,
    "entropy_coefficient": 0.001, "value_coefficient": 0.5, "actor_max_grad_norm": 1.0, "critic_max_grad_norm": 5.0,
    "epochs_per_rollout": 2, "minibatches": 8, "sequence_length": 1,
    "optimizer": {"type": "adam", "actor_learning_rate": 0.0003, "critic_learning_rate": 0.0001}
  },
  "collector": {"control_steps_per_rollout": 16},
  "evaluation": {},
  "checkpoint": {"interval_control_steps": 32, "keep_last": 2},
  "recording": {}
}
