{
  "schema_version": 1,
  "experiment": {
    "name": "attitude_gru_ppo_smoke"
  },
  "run": {
    "device": "cpu",
    "dtype": "float32",
    "parallel_count": 8,
    "rollout_steps": 16,
    "total_control_steps": 128,
    "seed": 20260721,
    "output_root": "../../runs",
    "allow_unimplemented_simulator": true
  },
  "environment": {
    "config_path": "../environment/sim_smoke.json"
  },
  "task": {
    "episode_duration_s": 30.0,
    "max_target_tilt_rad": 0.35,
    "max_target_yaw_rad": 3.141592653589793,
    "terminate_tilt_rad": 1.3,
    "terminate_angular_rate_rad_s": 20.0,
    "attitude_source": "truth",
    "reward": {
      "attitude_weight": 4.0,
      "angular_rate_weight": 0.1,
      "action_rate_weight": 0.01,
      "saturation_weight": 0.02,
      "alive_bonus": 0.1
    }
  },
  "model": {
    "encoder_sizes": [64, 64],
    "hidden_size": 64,
    "actor_head_size": 64
  },
  "algorithm": {
    "name": "recurrent_ppo",
    "gamma": 0.995,
    "gae_lambda": 0.95,
    "clip_epsilon": 0.2,
    "entropy_coefficient": 0.001,
    "value_coefficient": 0.5,
    "max_grad_norm": 1.0,
    "learning_rate": 0.0003,
    "epochs": 1,
    "sequence_length": 8,
    "sequences_per_minibatch": 8
  }
}
