+bool UdpLink::send_mocap_attitude(
+    std::uint32_t sample_sequence, std::uint64_t sample_mono_ns,
+    const Quaternion& q, float variance) {
+    const auto now = Clock::now();
+    const auto now_ns = static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(now.time_since_epoch()).count());
+    const double norm_sq = q.w*q.w + q.x*q.x + q.y*q.y + q.z*q.z;
+    const std::lock_guard lock(impl_->mutex);
+    if (!impl_->sync_valid || now - impl_->last_sync_at > std::chrono::seconds(3)
+        || !impl_->telemetry_link_ready_locked(now)
+        || !fresh(now, impl_->last_heartbeat_rx, impl_->config.heartbeat_timeout_ms, impl_->heartbeat.valid)
+        || sample_mono_ns == 0 || sample_mono_ns > now_ns
+        || sample_mono_ns <= impl_->last_mocap_sample_ns
+        || now_ns - sample_mono_ns > 50'000'000ULL
+        || now < impl_->next_mocap_tx
+        || !is_finite(q) || std::abs(norm_sq - 1.0) > 1e-3
+        || !std::isfinite(variance) || variance < 1e-6f || variance > 1.f) {
+        return false;
+    }
+    // NTP midpoint estimate; FC tolerates up to half the maximum accepted RTT
+    // of clock asymmetry. No artificial transport delay is added to sample time.
+    const auto fc_sample_us = static_cast<std::int64_t>(sample_mono_ns / 1000U) + impl_->fc_offset_us;
+    if (fc_sample_us <= 0) return false;
+    const auto frame = encode_mocap_attitude(impl_->next_sequence_locked(), impl_->session_id,
+        sample_sequence, static_cast<std::uint64_t>(fc_sample_us), q, variance);
+    // Consume samples even on congestion: no retry of old observations.
+    impl_->last_mocap_sample_ns = sample_mono_ns;
+    if (now - impl_->next_mocap_tx >= std::chrono::milliseconds(20)) {
+        impl_->next_mocap_tx = now;
+    }
+    impl_->next_mocap_tx += std::chrono::milliseconds(20);
+    const bool sent = impl_->raw_send_locked(frame);
+    if (sent) ++impl_->mocap_tx_packets;
+    return sent;
+}
+
 Status UdpLink::status() const {
     return impl_->status();
 }
