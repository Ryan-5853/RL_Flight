+void test_mocap_attitude_codec() {
+    using namespace dock_ground;
+    using namespace dock_ground::gs_link;
+    const Quaternion q = normalized(Quaternion{0.7, 0.2, -0.3, 0.4});
+    const auto frame = encode_mocap_attitude(42, 0x12345678, 99, 12000, q, 0.0025f);
+    const auto decoded = decode_frame(frame);
+    check(frame.size() == 48 && frame[4] == 3 && frame[8] == 36,
+          "mocap wire ID, payload size and total frame size");
+    check(decoded.failure == DecodeFailure::None, "mocap frame CRC and header");
+    const auto read_float = [&](std::size_t offset) {
+        std::uint32_t bits = 0;
+        for (unsigned i = 0; i < 4; ++i) bits |= std::uint32_t(frame[offset+i]) << (8*i);
+        return std::bit_cast<float>(bits);
+    };
+    check(frame[10] == 0x78 && frame[13] == 0x12 && frame[14] == 99,
+          "mocap session and sample sequence little endian");
+    check(std::abs(read_float(26)-q.w) < 1e-6 && std::abs(read_float(30)-q.x) < 1e-6
+          && std::abs(read_float(34)+q.y) < 1e-6 && std::abs(read_float(38)+q.z) < 1e-6,
+          "FLU body/world to FRD body/world quaternion basis change");
+    check(std::abs(read_float(42)-0.0025f) < 1e-8, "mocap rad squared variance");
+}
